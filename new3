Процедура ПосчитатьСумму()
    // Объявляем переменные
    Число1 = 5;
    Число2 = 7;
    
    // Считаем сумму
    Сумма = Число1 + Число2;
    
    // Выводим результат
    Сообщить("Сумма чисел " + Формат(Число1) + " и " + Формат(Число2) + " равна " + Формат(Сумма));
КонецПроцедуры

// Вызов процедуры
ПосчитатьСумму();